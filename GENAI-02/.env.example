# Application
APP_ENV=development
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8010
API_ACCESS_TOKEN=

# PostgreSQL / LangGraph checkpointing
DATABASE_URL=postgresql://nexvia:nexvia_dev_password@localhost:5432/nexvia_agents
PERSISTENCE_ENABLED=true
DATABASE_CONNECT_TIMEOUT=8
LANGGRAPH_AES_KEY=

# Optional model provider. Without OPENAI_API_KEY the graph runs in deterministic offline mode.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=

# Optional web search provider. If absent, the web-search tool falls back to Wikipedia OpenSearch.
TAVILY_API_KEY=
SEC_USER_AGENT=NexviaGenAIInternship/1.0 (educational research workflow)

# E2B. SANDBOX_MODE=mock is safe for local no-key tests and does not execute code on the host.
E2B_API_KEY=
SANDBOX_MODE=mock
SANDBOX_TIMEOUT_SECONDS=25
SANDBOX_REQUEST_TIMEOUT_SECONDS=40

# Workspace and browser policy
WORKSPACE_DIR=./workspace
WORKSPACE_MAX_FILE_BYTES=2000000
BROWSER_ALLOWED_DOMAINS=["sec.gov","www.sec.gov","data.sec.gov","en.wikipedia.org","wikipedia.org"]
BROWSER_NAVIGATION_TIMEOUT_MS=12000

# Hard workflow budgets
MAX_STEPS=12
MAX_REVISIONS=2
MAX_TOKENS_PER_RUN=18000
MAX_COST_USD_PER_RUN=0.75
MAX_INPUT_CHARS=8000
MAX_REPORT_CHARS=30000

# OpenTelemetry to local Jaeger OTLP HTTP endpoint
OTEL_ENABLED=true
OTEL_SERVICE_NAME=nexvia-genai-02
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_HEADERS=
