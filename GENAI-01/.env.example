# Copy to .env. This file contains development defaults only.
APP_NAME=Nexvia Enterprise RAG
ENVIRONMENT=development
LOG_LEVEL=INFO
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ALLOW_DEMO_AUTH=true
JWT_SECRET=replace-this-development-secret-with-a-random-32-character-minimum-value
JWT_ISSUER=nexvia-genai-01
JWT_EXPIRY_MINUTES=480
MAX_QUERY_CHARS=2000
MAX_UPLOAD_BYTES=26214400

# Vector backend: qdrant for docker/local cluster; memory for ephemeral tests only.
VECTOR_STORE=qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=nexvia_enterprise_knowledge
VECTOR_SIZE=384
DENSE_TOP_K=24
LEXICAL_TOP_K=24
FINAL_TOP_N=6
MIN_RELEVANCE_SCORE=0.24
RRF_K=60
PARENT_EXPANSION=true

# Default providers allow a complete key-free reviewer smoke test. Change to openai for live APIs.
EMBEDDING_PROVIDER=hash
EMBEDDING_MODEL=text-embedding-3-small
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
LLM_PROVIDER=mock
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=900
INPUT_COST_PER_MILLION_TOKENS=0.15
OUTPUT_COST_PER_MILLION_TOKENS=0.60
COHERE_API_KEY=
COHERE_RERANK_MODEL=rerank-v3.5

SQLITE_PATH=./data/nexvia_rag.sqlite3
CACHE_TTL_SECONDS=900
SEMANTIC_CACHE_THRESHOLD=0.985
CACHE_ENABLED=true

LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=nexvia-genai-01
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Required only when using --include-sec in scripts/populate_demo_corpus.py.
SEC_USER_AGENT=
